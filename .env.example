# Qdrant Collective Brain MCP Configuration

# Qdrant connection (inside docker compose network, use http://qdrant:6333; for local host use http://localhost:6333)
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_TIMEOUT=30.0

# Collections (MCP managed)
MEMORY_COLLECTION=collective_memories
DOCUMENT_COLLECTION=collective_documents

# FastEmbed Models (ONNX CPU)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANKER_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
VECTOR_DIM=384

# Server Ports
HOST=0.0.0.0
PORT=5006

# Chunking Configuration
CHUNK_SIZE_DEFAULT=800
CHUNK_OVERLAP_DEFAULT=150
MAX_CANDIDATES_FOR_RERANK=8

# Retrieval: skip rerank / return empty when nothing is actually similar
VECTOR_SCORE_THRESHOLD=0.64
MIN_RELEVANCE_CONFIDENCE=0.05
ONNX_THREADS=1
TOOL_TIMEOUT=20.0
NEAR_DUP_COSINE_THRESHOLD=0.92
RECENCY_TIE_BOOST=0.03
MAX_MEMORY_CHARS=20000
MAX_DOCUMENT_CHARS=200000
MAX_BATCH_ITEMS=50
